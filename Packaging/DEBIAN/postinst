#!/bin/sh
# Scripts/package-deb.sh substitutes the install prefix below: empty for
# roothide (whose dpkg relocates rootful paths into the randomized bootstrap
# root) and /var/jb for rootless.

find_tool() {
    for candidate in "@PREFIX@/usr/bin/$1" "/usr/bin/$1" "/bin/$1"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# The app has no container, so its home is mobile's, shared with every other
# app without one: inside the jbroot on roothide (whose sh reads /var/mobile
# there, as the app does), the system's own on rootless. A sandbox would hand
# it a Documents folder of its own; here the shared Documents is made for
# mobile when missing, and the app keeps its data in a folder named for its
# bundle id inside it, so no two such apps write into each other's. dpkg runs
# this as root, so each missing level is made and handed to mobile on its
# own: `mkdir -p` leaves every level above the last one root's, and mobile
# can then make nothing beside it. A level that exists is left as it is, and
# a symlink is never followed: mobile could plant one to have root hand it
# some other directory.
app_data=/var/mobile/Documents/wiki.qaq.Inspector
mobile_dir() {
    if [ -L "$1" ]; then
        return 1
    fi
    if [ -d "$1" ]; then
        return 0
    fi
    mkdir -m 0755 "$1" && chown -h 501:501 "$1"
}
for directory in /var/mobile /var/mobile/Documents "$app_data"; do
    mobile_dir "$directory" || {
        echo "warning: $directory could not be prepared for mobile." >&2
        break
    }
done

# The daemon id is named once, alone on its line. A rename that swallows the
# space before a redirect turns `system/<id> 2>/dev/null` into
# `system/<id>2>/dev/null`: still valid sh, so `sh -n` passes, but launchctl is
# handed the wrong label and its errors are no longer silenced.
label=wiki.qaq.inspectord
# Releases through 0.5.6 ran the daemon under this label. Their prerm leaves it
# loaded on upgrade, holding the Mach service the new daemon needs; dpkg has
# already removed its plist and binary by the time this runs.
legacy_label=wiki.qaq.cocoainspectord
launch_plist="@PREFIX@/Library/LaunchDaemons/$label.plist"
if launchctl="$(find_tool launchctl)"; then
    "$launchctl" bootout "system/$legacy_label" 2>/dev/null || true
    "$launchctl" bootout "user/501/$legacy_label" 2>/dev/null || true
    "$launchctl" bootout "gui/501/$legacy_label" 2>/dev/null || true
    # Roothide's launchctl can land a jbroot daemon in the per-user domain
    # even when asked for system. An upgrade that only boots out system/
    # leaves the old instance holding the Mach service.
    "$launchctl" bootout "system/$label" 2>/dev/null || true
    "$launchctl" bootout "user/501/$label" 2>/dev/null || true
    "$launchctl" bootout "gui/501/$label" 2>/dev/null || true
    "$launchctl" enable "system/$label" 2>/dev/null || true
    "$launchctl" bootstrap system "$launch_plist"
fi

exit 0
