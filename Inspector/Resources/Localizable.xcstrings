        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사본은 더 이상 설치되어 있지 않습니다. 계속하려면 종료한 뒤 Inspector을(를) 다시 여십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
