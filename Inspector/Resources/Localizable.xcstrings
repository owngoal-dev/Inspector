    "This ends the process immediately. Unsaved work can be lost.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي هذا العملية فورًا، وقد تُفقد الأعمال غير المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozess wird sofort beendet. Nicht gesicherte Arbeit kann verloren gehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ends the process immediately. Unsaved work can be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso terminará de inmediato. El trabajo sin guardar puede perderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus s’arrête immédiatement. Le travail non enregistré peut être perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina subito il processo. Il lavoro non salvato può andare perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスをただちに終了します。保存していない作業は失われることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스를 즉시 종료합니다. 저장하지 않은 작업이 사라질 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso encerra o processo imediatamente. O trabalho não salvo pode ser perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесс завершится немедленно. Несохранённые данные могут быть потеряны."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này kết thúc tiến trình ngay lập tức. Nội dung chưa lưu có thể bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会立即结束进程，未保存的内容可能丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會立即結束程序，未儲存的內容可能會遺失。"
          }
        }
      }
    },
