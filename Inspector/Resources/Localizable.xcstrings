          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會要求程序自行關閉。"
          }
        }
      }
    },
    "This copy is no longer installed. Quit it and open Inspector again to continue.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هذه النسخة مثبتة. أنهِها وافتح Inspector من جديد للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie ist nicht mehr installiert. Beende sie und öffne Inspector erneut, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy is no longer installed. Quit it and open Inspector again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia ya no está instalada. Sal de ella y vuelve a abrir Inspector para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie n’est plus installée. Quittez-la et rouvrez Inspector pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia non è più installata. Chiudila e riapri Inspector per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーはすでにインストールされていません。終了してから Inspector を開き直してください。"
