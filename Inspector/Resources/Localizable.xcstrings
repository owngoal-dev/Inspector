    "This asks the process to shut down on its own.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب هذا من العملية أن تُغلق نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozess wird gebeten, sich selbst zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This asks the process to shut down on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide al proceso que se cierre por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus est invité à se fermer de lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede al processo di chiudersi da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスに自分で終了するよう求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스가 스스로 종료하도록 요청합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso pede que o processo se encerre por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессу будет предложено завершиться самостоятельно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này yêu cầu tiến trình tự tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
